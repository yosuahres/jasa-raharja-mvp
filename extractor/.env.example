# Supabase project → Project Settings → API. Copy to extractor/.env and fill in.
SUPABASE_URL=https://your-project-ref.supabase.co
# The secret key (sb_secret_...) or the legacy service_role key. It bypasses row-level security: keep it on the worker machine only.
SUPABASE_SECRET_KEY=sb_secret_xxx
# The dashboard sends this with each wake call (its EXTRACTOR_SECRET must match). Any long random
# string: openssl rand -hex 32. Without it the worker has no endpoint and only polls.
EXTRACTOR_SECRET=
