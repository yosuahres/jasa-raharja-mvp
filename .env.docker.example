# Copy to .env next to docker-compose.yml on the server.

# Host the dashboard is served on. *.majorsaleshub.com already resolves to the VPS.
JR_DOMAIN=jasaraharja.majorsaleshub.com
# Host the extractor's wake endpoint is served on; the dashboard's EXTRACTOR_URL points here.
JR_EXTRACTOR_DOMAIN=jasaraharja-extractor.majorsaleshub.com

# Only for building the dashboard image locally (the `build:` block in docker-compose.yml).
# CI builds it from the repository secrets of the same names.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
