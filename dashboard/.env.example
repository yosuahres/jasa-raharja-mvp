# Supabase project → Project Settings → API. Copy to .env.local and fill in.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key. Safe in the browser: access is enforced by row-level security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
